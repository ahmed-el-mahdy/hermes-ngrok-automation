FROM nousresearch/hermes-agent:v2026.7.20

ENV VIRTUAL_ENV=/opt/hermes/.venv
ENV PIP_TARGET=/opt/data/python-packages
ENV PYTHONPATH=/opt/data/python-packages
ENV UV_CACHE_DIR=/opt/data/cache/uv
ENV NODE_PATH=/usr/local/lib/node_modules

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        file \
        fonts-liberation \
        jq \
        libmagic1 \
        libreoffice-impress \
        poppler-utils \
        tesseract-ocr \
        tesseract-ocr-ara \
    && rm -rf /var/lib/apt/lists/*

RUN uv pip install \
    "faster-whisper==1.2.1" \
    "sounddevice==0.5.5" \
    "numpy==2.4.3" \
    "edge-tts==7.2.7" \
    "beautifulsoup4>=4.13,<5" \
    "ddgs>=9,<10" \
    "lxml>=5.4,<7" \
    "PyMuPDF>=1.25,<2" \
    "python-docx>=1.1,<2" \
    "pypdf>=5.4,<7" \
    "pdfplumber>=0.11,<1" \
    "openpyxl>=3.1,<4" \
    "markitdown[pptx]==0.1.6" \
    "fastapi>=0.116,<1" \
    "httpx>=0.28,<1" \
    "uvicorn>=0.35,<1" \
    "pytest>=8.3,<10" \
    "pip>=25,<27" \
    "cryptography>=48.0.1,<49" \
    "httplib2>=0.32,<1" \
    "mcp>=1.28.1,<2" \
    "Pillow>=12.3,<13" \
    "pyasn1>=0.6.4,<1" \
    "python-multipart>=0.0.31,<1" \
    "starlette>=1.3.1,<2" \
    "tornado>=6.5.7,<7" \
    "Pygments>=2.20,<3" \
    "pydantic-settings>=2.14.2,<3" \
    "PyNaCl>=1.6.2,<2"

# Upstream v0.19.0 pins two vulnerable builds exactly. Keep the patched
# runtime wheels and reject every dependency conflict except those two known
# metadata-only pin mismatches.
RUN uv pip check >/tmp/hermes-pip-check 2>&1 || true \
    && sed -i \
        -e '/hermes-agent.*requires.*cryptography/d' \
        -e '/hermes-agent.*requires.*pillow/d' \
        -e '/^Checked [0-9][0-9]* packages/d' \
        -e '/^Found [0-9][0-9]* incompatibilit/d' \
        /tmp/hermes-pip-check \
    && cat /tmp/hermes-pip-check \
    && test ! -s /tmp/hermes-pip-check \
    && rm /tmp/hermes-pip-check

RUN npm install --global --omit=dev "pptxgenjs@4.0.1"

COPY patch-hermes-stt.py /tmp/patch-hermes-stt.py
COPY patch-hermes-media-delivery.py /tmp/patch-hermes-media-delivery.py
COPY patch-hermes-personal-context.py /tmp/patch-hermes-personal-context.py
COPY personal-context-tool.py /opt/hermes/tools/personal_context_tool.py
RUN /opt/hermes/.venv/bin/python /tmp/patch-hermes-stt.py \
    && /opt/hermes/.venv/bin/python /tmp/patch-hermes-media-delivery.py \
    && /opt/hermes/.venv/bin/python /tmp/patch-hermes-personal-context.py \
    && rm \
        /tmp/patch-hermes-stt.py \
        /tmp/patch-hermes-media-delivery.py \
        /tmp/patch-hermes-personal-context.py \
    && ln -sf /opt/hermes/.venv/bin/hermes /usr/local/bin/hermes \
    && ln -sf /opt/hermes/.venv/bin/python /usr/local/bin/hermes-python

RUN install -d -m 0755 /opt/hermes/skills/personal-context
COPY personal-memory/SKILL.md /opt/hermes/skills/personal-context/SKILL.md
COPY personal-context-tool.py /usr/local/bin/hermes-personal-memory
COPY personal-attachment-ocr.py /usr/local/bin/hermes-personal-ocr
COPY hermes-admin.py /usr/local/bin/hermes-admin
COPY hermes-smoke-test.sh /usr/local/bin/hermes-smoke-test
COPY validate-hermes-runtime.py /usr/local/bin/validate-hermes-runtime
COPY validate-personal-context.py /usr/local/bin/validate-personal-context
COPY validate-telegram.py /usr/local/bin/validate-telegram
COPY validate-model-routes.py /usr/local/bin/validate-model-routes
COPY validate-vision.py /usr/local/bin/validate-vision
COPY validate-telegram-media.py /usr/local/bin/validate-telegram-media
COPY ollama-openai-bridge.py /opt/hermes-extensions/ollama-openai-bridge.py
RUN chmod 0755 \
    /usr/local/bin/hermes-admin \
    /usr/local/bin/hermes-personal-memory \
    /usr/local/bin/hermes-personal-ocr \
    /usr/local/bin/hermes-smoke-test \
    /usr/local/bin/validate-hermes-runtime \
    /usr/local/bin/validate-personal-context \
    /usr/local/bin/validate-telegram \
    /usr/local/bin/validate-model-routes \
    /usr/local/bin/validate-vision \
    /usr/local/bin/validate-telegram-media \
    /opt/hermes-extensions/ollama-openai-bridge.py \
    && sed -i 's/\r$//' \
    /usr/local/bin/hermes-admin \
    /usr/local/bin/hermes-personal-memory \
    /usr/local/bin/hermes-personal-ocr \
    /usr/local/bin/hermes-smoke-test \
    /usr/local/bin/validate-hermes-runtime \
    /usr/local/bin/validate-personal-context \
    /usr/local/bin/validate-telegram \
    /usr/local/bin/validate-model-routes \
    /usr/local/bin/validate-vision \
    /usr/local/bin/validate-telegram-media \
    /opt/hermes-extensions/ollama-openai-bridge.py
