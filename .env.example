# Hermes Agent + ngrok automation
# Copy this file to .env and fill in the secrets before running Docker Compose.

# Required: ngrok auth token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Required by Hermes gateway API.
# The deployment script auto-generates this in ~/hermes-ngrok/.env.
API_SERVER_KEY=change_me_to_a_long_random_api_key

# Hermes API port. The native Hermes dashboard is disabled; Open WebUI is the UI.
HERMES_API_PORT=8642

# Open WebUI is the public dashboard ngrok tunnels to.
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_NAME=Hermes Open WebUI
OPEN_WEBUI_ADMIN_EMAIL=admin@hermes.local
OPEN_WEBUI_ADMIN_PASSWORD=change_me_to_a_long_random_password
OPEN_WEBUI_SECRET_KEY=change_me_to_a_long_random_secret
OPEN_WEBUI_PUBLIC_URL=

# Native Ollama API exposed by the Windows host and restricted to this VM.
OLLAMA_BASE_URL=http://192.168.1.2:11434

# Docker network name.
DOCKER_NETWORK=hermes_net

# Logging.
LOG_LEVEL=INFO

# Persistent host paths. Defaults match the Ubuntu VM deployment.
HERMES_DATA_DIR=/home/cyber/.hermes
HERMES_LOG_DIR=/home/cyber/hermes-ngrok/logs
HERMES_WORKSPACE_DIR=/home/cyber/hermes_workspace

# Optional LLM provider keys. Configure these after first portal access,
# or uncomment and set them here before restarting the stack.
# OPENROUTER_API_KEY=your_openrouter_key_here
# GOOGLE_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional Telegram gateway. Leave the token empty to keep Telegram disabled.
# Use numeric Telegram user IDs, comma separated. Never enable allow-all access.
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_ALLOWED_USERS=123456789
# TELEGRAM_GROUP_ALLOWED_USERS=123456789
# TELEGRAM_GROUP_ALLOWED_CHATS=-1001234567890
TELEGRAM_REQUIRE_MENTION=true
