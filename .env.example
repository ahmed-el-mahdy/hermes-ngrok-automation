# Hermes Agent + ngrok automation
# Copy this file to .env and fill in the secrets before running Docker Compose.

# Required: ngrok auth token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Required for ngrok public URL basic auth.
# The deployment script auto-generates NGROK_AUTH_PASS in ~/hermes-ngrok/.env.
NGROK_AUTH_USER=hermes
NGROK_AUTH_PASS=change_me_to_a_long_random_password

# Required by Hermes gateway API.
# The deployment script auto-generates this in ~/hermes-ngrok/.env.
API_SERVER_KEY=change_me_to_a_long_random_api_key

# Hermes dashboard and API ports.
HERMES_DASHBOARD_PORT=9119
HERMES_API_PORT=8642

# Docker network name.
DOCKER_NETWORK=hermes_net

# Logging.
LOG_LEVEL=INFO

# Optional LLM provider keys. Configure these after first portal access,
# or uncomment and set them here before restarting the stack.
# OPENROUTER_API_KEY=your_openrouter_key_here
# GOOGLE_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional notifications.
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# URL watcher configuration used by the deployment script helper service.
URL_CHECK_INTERVAL=30
