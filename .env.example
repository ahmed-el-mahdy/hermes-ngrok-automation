# ========================================
# HERMES AGENT + NGROK AUTOMATION - ENV FILE
# ========================================
# This file contains all configuration variables
# for Hermes Agent deployment with Ngrok tunneling.
# 
# Copy this to .env and fill in your values.
# IMPORTANT: .env is NOT committed to Git!
# ========================================

# ========================================
# 🔐 NGROK CONFIGURATION
# ========================================
# Your Ngrok authentication token
# Get it from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional: If you have a paid Ngrok plan with a static domain
# Leave empty for free tier (random URL)
# Example: NGROK_DOMAIN=my-hermes.ngrok-free.dev
NGROK_DOMAIN=

# ========================================
# 🤖 HERMES CONFIGURATION
# ========================================
# Hermes Dashboard Port (Web GUI)
# This is what ngrok will tunnel to the internet
HERMES_PORT=9119

# Hermes API Port (OpenAI-compatible API)
# Used for programmatic access to Hermes
HERMES_API_PORT=8642

# ========================================
# 🧠 LLM PROVIDER CONFIGURATION
# ========================================
# Configure these AFTER you access the web portal
# Leave commented out initially, add via dashboard interface

# OpenRouter (Recommended for free tier)
# Get key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_key_here

# Google Gemini (Free tier available)
# Get key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_key_here

# OpenAI (Optional, if you have an API key)
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here

# ========================================
# 📬 NOTIFICATIONS (Optional)
# ========================================
# Telegram bot token for URL change notifications
# Leave commented out if not needed
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# ========================================
# 🔄 URL WATCHER CONFIGURATION
# ========================================
# How often to poll Ngrok API for URL changes (seconds)
URL_CHECK_INTERVAL=30

# Log file location for URL watcher
URL_WATCHER_LOG=/opt/hermes/logs/url-watcher.log

# ========================================
# 📦 DOCKER CONFIGURATION
# ========================================
# Docker network name for Hermes services
DOCKER_NETWORK=hermes_net

# Hermes container name
HERMES_CONTAINER_NAME=hermes-agent

# Ngrok container name
NGROK_CONTAINER_NAME=ngrok-hermes

# ========================================
# 🔒 SECURITY (Optional)
# ========================================
# Initial admin password (leave empty for no auth on first access)
# You can change this later via the Hermes dashboard
# HERMES_ADMIN_PASSWORD=

# Enable CORS (allow cross-origin requests)
# HERMES_ENABLE_CORS=true

# ========================================
# 📊 LOGGING & MONITORING
# ========================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable detailed request logging
# HERMES_VERBOSE_LOGGING=false

# ========================================
# 🌐 NETWORKING
# ========================================
# Hermes bind address (0.0.0.0 = accessible from all interfaces)
HERMES_BIND_ADDRESS=0.0.0.0

# ========================================
# 💾 DATA & PERSISTENCE
# ========================================
# Root data directory
DATA_DIR=/opt/hermes/hermes_data

# Backup directory (if you want to enable backups later)
BACKUP_DIR=/opt/hermes/backups

# ========================================
# 🎯 OPTIONAL: ADVANCED SETTINGS
# ========================================
# Custom model configuration (if needed)
# HERMES_MODEL_NAME=hermes-2-pro

# Custom API endpoint (for self-hosted LLM backends)
# CUSTOM_LLM_ENDPOINT=http://localhost:8000

# Maximum request timeout (seconds)
# REQUEST_TIMEOUT=300
